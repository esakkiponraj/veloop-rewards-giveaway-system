# ==============================================================================
# VELOOP REWARDS BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your deployment-specific credentials.
# Do not commit .env to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (MongoDB Atlas SRV connection string or local daemon)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/veloop_rewards?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/veloop_rewards

# JWT Session Security Secret (Generate a high-entropy 256-bit string)
JWT_SECRET=your_jwt_secret_min_32_characters_long

# Allowed Frontend Client Origin for CORS Security
# In production, set this to your deployed frontend domain (e.g. https://rewards.veloop.io)
CLIENT_URL=http://localhost:5173

# Optional: Set to false in production to enforce strict fail-closed database mode
ALLOW_IN_MEMORY_FALLBACK=false
